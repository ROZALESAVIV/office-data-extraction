# ── Database ─────────────────────────────────────────────────────────────────
# DATABASE_URL is the connection the APPLICATION uses. It must be a role that is
# NOT the owner of the tables and has neither SUPERUSER nor BYPASSRLS. Both of
# those bypass row-level security entirely, which means every law firm would see
# every other firm's cases regardless of the policies.
#
# On Supabase the default `postgres` role is a superuser — do NOT use it here.
# Create a dedicated role instead (the rls_hardening migration will do it for
# you if you set APP_DB_ROLE / APP_DB_PASSWORD below).
#
# Use the direct connection on port 5432, not the transaction pooler on 6543:
# tenant context and advisory locks are transaction-scoped and the pooler
# interferes with both.
DATABASE_URL=postgresql://ode_app:CHANGE_ME@db.<project>.supabase.co:5432/postgres

# Owner connection. Used only by Alembic and the startup recovery sweep.
DATABASE_ADMIN_URL=postgresql://postgres:CHANGE_ME@db.<project>.supabase.co:5432/postgres

# Set these and `alembic upgrade head` creates and grants the application role.
# Leave empty if you create the role by hand.
APP_DB_ROLE=ode_app
APP_DB_PASSWORD=CHANGE_ME

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# ── Storage (Supabase) ───────────────────────────────────────────────────────
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=case-documents

# ── Extraction ───────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── API ──────────────────────────────────────────────────────────────────────
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173
